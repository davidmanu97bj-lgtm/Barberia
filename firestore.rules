rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function belongsToBusiness(businessId) {
      return signedIn()
        && exists(/databases/$(database)/documents/businesses/$(businessId)/users/$(request.auth.uid));
    }

    function isAdmin(businessId) {
      return signedIn()
        && get(/databases/$(database)/documents/businesses/$(businessId)/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /businesses/{businessId}/users/{userId} {
      allow read: if isOwner(userId) || isAdmin(businessId);
      allow create: if isOwner(userId) && request.resource.data.role != 'admin';
      allow update: if isAdmin(businessId)
        || (isOwner(userId) && request.resource.data.role == resource.data.role);
      allow delete: if false;

      match /payments/{paymentId} {
        allow read: if isOwner(userId) || isAdmin(businessId);
        allow create: if isOwner(userId) || isAdmin(businessId);
        allow update, delete: if false;
      }

      match /expenses/{expenseId} {
        allow read: if isOwner(userId) || isAdmin(businessId);
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }

      match /uber/{weekId} {
        allow read: if isOwner(userId) || isAdmin(businessId);
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }

      // Adelanto solicitado por el chofer. Se crea con un máximo de $400.000
      // y una deuda total compuesta por capital + 40%. Los cobros digitales
      // solo pueden disminuir el saldo; nunca aumentarlo ni alterar el capital.
      match /advances/{advanceId} {
        allow read: if isOwner(userId) || isAdmin(businessId);
        allow create: if isOwner(userId)
          && request.resource.data.type == 'cash_advance'
          && request.resource.data.businessId == businessId
          && request.resource.data.operatorUid == userId
          && request.resource.data.principalAmount > 0
          && request.resource.data.principalAmount <= 400000
          && request.resource.data.interestPercent == 40
          && request.resource.data.interestAmount >= request.resource.data.principalAmount * 0.40 - 1
          && request.resource.data.interestAmount <= request.resource.data.principalAmount * 0.40 + 1
          && request.resource.data.totalDebt == request.resource.data.principalAmount + request.resource.data.interestAmount
          && request.resource.data.remainingAmount == request.resource.data.totalDebt
          && request.resource.data.repaidAmount == 0
          && request.resource.data.differenceAtRequest >= 0
          && request.resource.data.differenceAtRequest < 50000
          && request.resource.data.status == 'active';
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'remainingAmount', 'repaidAmount', 'status', 'updatedAt'
          ])
          && request.resource.data.remainingAmount >= 0
          && request.resource.data.remainingAmount <= resource.data.remainingAmount
          && request.resource.data.repaidAmount == request.resource.data.totalDebt - request.resource.data.remainingAmount
          && (
            (request.resource.data.remainingAmount > 0 && request.resource.data.status == 'active')
            || (request.resource.data.remainingAmount == 0 && request.resource.data.status == 'paid')
          );
        allow delete: if false;
      }

      match /closures/{closureId} {
        allow read: if isOwner(userId) || isAdmin(businessId);
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }
    }

    // Cierres compartidos: el chofer crea su pedido y el administrador puede
    // completar los pagos de Explora y adjuntar el comprobante correspondiente.
    match /businesses/{businessId}/closures/{closureId} {
      allow read: if signedIn()
        && (resource.data.operatorUid == request.auth.uid || isAdmin(businessId));
      allow create: if signedIn()
        && request.resource.data.operatorUid == request.auth.uid
        && request.resource.data.businessId == businessId;
      allow update: if isAdmin(businessId);
      allow delete: if false;
    }

    // La deuda diaria es visible para la caja y solamente puede ser creada
    // por un perfil administrador. El chofer no puede editarla ni eliminarla.
    match /businesses/{businessId}/debts/{debtId} {
      allow read: if belongsToBusiness(businessId);
      allow create: if isAdmin(businessId)
        && request.resource.data.businessId == businessId
        && request.resource.data.type == 'admin_debt'
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.amount > 0;
      allow update, delete: if false;
    }
  }
}
