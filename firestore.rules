rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roleIsAdmin(data) {
      return data != null && (
        (data.keys().hasAny(['role']) && data.role in ['admin', 'administrador', 'owner', 'propietario', 'superadmin']) ||
        (data.keys().hasAny(['rol']) && data.rol in ['admin', 'administrador', 'owner', 'propietario', 'superadmin']) ||
        (data.keys().hasAny(['admin']) && data.admin == true) ||
        (data.keys().hasAny(['isAdmin']) && data.isAdmin == true)
      );
    }

    function adminFromToken() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role in ['admin', 'administrador', 'owner', 'propietario', 'superadmin'] ||
        request.auth.token.rol in ['admin', 'administrador', 'owner', 'propietario', 'superadmin']
      );
    }

    function adminFromDocument() {
      return signedIn() && (
        exists(/databases/$(database)/documents/administradores/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/barberos/$(request.auth.uid)) &&
          roleIsAdmin(get(/databases/$(database)/documents/barberos/$(request.auth.uid)).data)) ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
          roleIsAdmin(get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          roleIsAdmin(get(/databases/$(database)/documents/users/$(request.auth.uid)).data)) ||
        (exists(/databases/$(database)/documents/perfiles/$(request.auth.uid)) &&
          roleIsAdmin(get(/databases/$(database)/documents/perfiles/$(request.auth.uid)).data))
      );
    }

    function isAdmin() {
      return adminFromToken() || adminFromDocument();
    }

    function owns(data) {
      return signedIn() && data != null && (
        (data.keys().hasAny(['barberUid']) && data.barberUid == request.auth.uid) ||
        (data.keys().hasAny(['barberoUid']) && data.barberoUid == request.auth.uid) ||
        (data.keys().hasAny(['uid']) && data.uid == request.auth.uid) ||
        (data.keys().hasAny(['ownerUid']) && data.ownerUid == request.auth.uid)
      );
    }

    function isValidCharge(data) {
      return data.keys().hasAll([
          'barberUid', 'barberName', 'amount', 'method', 'service',
          'createdAt', 'createdAtMs', 'businessId'
        ]) &&
        data.barberUid == request.auth.uid &&
        data.businessId == 'barberia-c25a1' &&
        data.amount is number && data.amount > 0 && data.amount <= 10000000 &&
        data.method in ['cash', 'digital'] &&
        data['service'] is string && data['service'].size() > 0 && data['service'].size() <= 100 &&
        data.barberName is string && data.barberName.size() > 0 && data.barberName.size() <= 120 &&
        data.createdAtMs is number && data.createdAtMs > 0;
    }

    function isValidClosure(data) {
      return data.keys().hasAll([
          'barberUid', 'barberName', 'status', 'direction', 'settlementAmount',
          'cashTotal', 'digitalTotal', 'advertisingFund', 'totalBilled', 'cutoffAtMs',
          'requestedAt', 'requestedAtMs', 'businessId'
        ]) &&
        data.barberUid == request.auth.uid &&
        data.businessId == 'barberia-c25a1' &&
        data.status == 'pending' &&
        data.direction in ['barber_pays_business', 'business_pays_barber', 'balanced'] &&
        data.settlementAmount is number && data.settlementAmount >= 0 &&
        data.cashTotal is number && data.cashTotal >= 0 &&
        data.digitalTotal is number && data.digitalTotal >= 0 &&
        data.advertisingFund is number && data.advertisingFund >= 0 &&
        data.totalBilled is number && data.totalBilled > 0 &&
        data.cutoffAtMs is number && data.cutoffAtMs > 0 &&
        data.requestedAtMs is number && data.requestedAtMs > 0;
    }

    match /administradores/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    match /barberos/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /perfiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /login_aliases/{alias} {
      allow read, write: if isAdmin();
    }

    match /cobros/{chargeId} {
      allow read: if isAdmin() || owns(resource.data);
      allow create: if signedIn() && isValidCharge(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /caja_publicidad/{receiptId} {
      allow read: if isAdmin() || owns(resource.data);
      allow create: if signedIn() && owns(request.resource.data) &&
        request.resource.data.businessId == 'barberia-c25a1' &&
        request.resource.data.amount is number && request.resource.data.amount > 0 &&
        request.resource.data.rate == 0.05 &&
        request.resource.data.contributionFrom in ['cash', 'digital'] &&
        request.resource.data.beneficiary == 'barberia' &&
        request.resource.data.destination == 'barberia_account';
      allow update, delete: if isAdmin();
    }

    match /saldos_barberos/{barberUid} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /cierres/{closureId} {
      allow read: if isAdmin() || owns(resource.data);
      allow create: if signedIn() && isValidClosure(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /admin_audit/{auditId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
