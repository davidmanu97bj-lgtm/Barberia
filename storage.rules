rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function roleIsAdmin(data) {
      return data != null && (
        (data.keys().hasAny(['role']) && data.role in ['admin', 'administrador', 'owner', 'propietario', 'superadmin']) ||
        (data.keys().hasAny(['rol']) && data.rol in ['admin', 'administrador', 'owner', 'propietario', 'superadmin']) ||
        (data.keys().hasAny(['admin']) && data.admin == true) ||
        (data.keys().hasAny(['isAdmin']) && data.isAdmin == true)
      );
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role in ['admin', 'administrador', 'owner', 'propietario', 'superadmin'] ||
        request.auth.token.rol in ['admin', 'administrador', 'owner', 'propietario', 'superadmin'] ||
        firestore.exists(/databases/(default)/documents/administradores/$(request.auth.uid)) ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) ||
        (firestore.exists(/databases/(default)/documents/barberos/$(request.auth.uid)) &&
          roleIsAdmin(firestore.get(/databases/(default)/documents/barberos/$(request.auth.uid)).data)) ||
        (firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid)) &&
          roleIsAdmin(firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data)) ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
          roleIsAdmin(firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data))
      );
    }

    function validFile() {
      return request.resource == null || (
        request.resource.size < 10 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf')
      );
    }

    match /cobros/{barberUid}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == barberUid || isAdmin());
      allow write: if signedIn() && (request.auth.uid == barberUid || isAdmin()) && validFile();
    }

    match /cierres/{barberUid}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == barberUid || isAdmin());
      allow write: if signedIn() && (request.auth.uid == barberUid || isAdmin()) && validFile();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
